    "name": "Task&Habits – nové API",
    "description": "Automatické testy pre Spring Boot API Task & Habits.\n\nSpúšťajte celú kolekciu cez Collection Runner (poradie požiadaviek je dôležité). Kolekcia si vytvorí nový testovací účet, ID si odovzdáva cez premenné kolekcie a na konci po sebe všetko zmaže.\n\nAutentifikácia: JWT v HttpOnly cookie `authToken` – Postman ju po registrácii/prihlásení posiela automaticky.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Autentifikácia",
      "item": [
        {
          "name": "Registrácia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Každé spustenie použije nový testovací účet",
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('email', `postman-${stamp}@example.test`);",
                  "pm.collectionVariables.set('username', `postman${stamp % 100000}`);",
                  "pm.collectionVariables.set('password', 'Test12345!');",
                  "pm.collectionVariables.set('newPassword', 'NoveHeslo123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"Vráti používateľa s ID a emailom\", () => {",
                  "  pm.expect(user.id).to.be.a('number');",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(user).to.not.have.property('password');",
                  "});",
                  "pm.test(\"Nastaví HttpOnly cookie authToken\", () => pm.expect(pm.cookies.has(\"authToken\")).to.be.true);",
                  "pm.collectionVariables.set('userId', user.id);"
                ]
              }
            }
          ]
        },
